{
  "name": "andrews-bibliotecary-demo",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1 --port 4173",
    "build": "node demo/scripts/licenses.mjs && tsc --noEmit -p demo/tsconfig.json && vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit -p demo/tsconfig.json",
    "test:domain": "tsc --noEmit -p demo/tsconfig.tests.json && node --experimental-strip-types --test demo/tests/domain.test.ts",
    "test": "node demo/scripts/playwright.mjs test",
    "test:install": "node demo/scripts/playwright.mjs install chromium firefox webkit",
    "security:check": "node demo/scripts/security.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
